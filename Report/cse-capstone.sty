%======================================================================
%  cse-capstone.sty
%  Formatting package for the CSE 450 Capstone Project report.
%
%  Provides: page geometry, fonts, chapter/section styling, headers/
%  footers, caption style, hyperref/bookmark setup, a \guidance{} note
%  environment (for any leftover drafting notes), and the frontmatter
%  macros used by frontmatter/titlepage.tex and declaration.tex.
%======================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cse-capstone}[2026/09/14 v1.0 CSE 450 Capstone report style]

% ---------------------------------------------------------------- geometry
\RequirePackage[a4paper,left=1.5in,right=1in,top=1in,bottom=1in]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{setspace}
\onehalfspacing
% Let justification stretch inter-word spaces more before giving up and
% producing a visibly overfull line -- the report's prose is dense with
% inline \texttt{} code spans and long compound technical terms that have
% no natural hyphenation point.
\emergencystretch=3em
\tolerance=1200

% ---------------------------------------------------------------- bibliography
\RequirePackage[round,authoryear]{natbib}

% ---------------------------------------------------------------- math / graphics / tables
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{longtable}
\RequirePackage{siunitx}
\RequirePackage{subcaption}
\RequirePackage[table]{xcolor}

% ---------------------------------------------------------------- captions
\RequirePackage[font=small,labelfont=bf,margin=10pt]{caption}

% ---------------------------------------------------------------- lists
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=*}
% `description` labels in this report are occasionally long phrases (not
% single words), which makes enumitem's default leftmargin=* compute a
% negative remaining label width; give description its own, safe layout
% (bold label runs into the text rather than trying to hang-indent to a
% width based on the widest label).
\setlist[description]{leftmargin=0pt, labelindent=0pt, font=\normalfont\bfseries}

% ---------------------------------------------------------------- code listings
\RequirePackage{listings}
\lstdefinestyle{cseCode}{
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue!60!black}\bfseries,
  commentstyle=\color{green!40!black}\itshape,
  stringstyle=\color{orange!70!black},
  numbers=left, numberstyle=\tiny\color{gray}, numbersep=8pt,
  frame=single, rulecolor=\color{gray!40}, breaklines=true,
  showstringspaces=false, tabsize=2, columns=flexible,
  backgroundcolor=\color{gray!5}
}
\lstset{style=cseCode}

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\definecolor{cseblue}{RGB}{0,51,102}
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\color{cseblue}}
  {\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titlespacing*{\chapter}{0pt}{-20pt}{30pt}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{cseblue}}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}{\thesubsubsection}{1em}{}

% ---------------------------------------------------------------- headers/footers
\RequirePackage{fancyhdr}
\setlength{\headheight}{14pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\leftmark}
\fancyhead[R]{\small\ProjectShortTitle}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\newcommand{\ProjectShortTitle}{}

% ---------------------------------------------------------------- hyperref (last)
% hyperref must be loaded (with our options) BEFORE bookmark, which would
% otherwise silently \RequirePackage{hyperref} with no options first and
% cause an "Option clash for package hyperref" fatal error.
\RequirePackage[colorlinks=true,
  linkcolor=cseblue, citecolor=cseblue!70!black,
  urlcolor=cseblue, filecolor=cseblue,
  bookmarksnumbered=true, bookmarksopen=true,
  pdfpagemode=UseOutlines]{hyperref}
\RequirePackage{bookmark}

% ---------------------------------------------------------------- frontmatter macros
% Team member entries: \addTeamMember{Name}{Student ID}
\newcommand{\TeamMembersList}{}
\newcommand{\addTeamMember}[2]{%
  \g@addto@macro\TeamMembersList{\item #1 \hfill \textnormal{(#2)}\par}%
}
\newenvironment{teammembers}{\begin{itemize}[leftmargin=1.2em,label={}]}{\end{itemize}}

% A visually distinct "fill this in" marker for any field the authors
% still owe (kept deliberately loud so it cannot be missed before submission).
\newcommand{\FillIn}[1]{{\color{red}\bfseries [FILL IN: #1]}}

% Guidance-note box, kept for compatibility with the original template
% convention; unused once a section's guidance text has been replaced.
\newenvironment{guidance}
  {\par\noindent\color{gray}\itshape}
  {\par}

% Abbreviation / acronym helper
\newcommand{\acr}[1]{\textsc{#1}}

\endinput
