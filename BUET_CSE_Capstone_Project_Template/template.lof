\contentsline {figure}{\numberline {5.4}{\ignorespaces Cross-domain transfer: ablation curves and confusion matrices on canonical ($N=500$) and augmented ($N=700$) benchmarks.}}{45}{figure.caption.34}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Training convergence dynamics and performance summaries across both e-commerce benchmarks.}}{45}{figure.caption.35}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Verified label distribution of the canonical e-commerce benchmark ($N=500$), displaying 262 negative / 238 affirmative instances across the four primary outcome categories.}}{46}{figure.caption.36}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Skew stress analysis of Antiphony under severe class imbalance, showing Macro-F1 resilience across affirmative training proportions from 47.7\% down to 9.8\%.}}{46}{figure.caption.37}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Tokenizer truncation forensic: left-truncation retains proximal conversational context, recovering Macro-F1 from 0.8133 to 0.9331 and shrinking the apparent necessity gap from 0.1600 to 0.0402.}}{47}{figure.caption.38}%
